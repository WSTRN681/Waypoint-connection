    descLbl.TextColor3 = SUBTEXT
    descLbl.TextSize = 10
    descLbl.Font = Enum.Font.GothamMedium
    descLbl.TextXAlignment = Enum.TextXAlignment.Left
    descLbl.ZIndex = 316
    descLbl.Parent = card

    local switchBtn = Instance.new("TextButton")
    switchBtn.Size = UDim2.fromOffset(55, 28)
    switchBtn.Position = UDim2.new(1, -63, 0.5, -14)
    switchBtn.BorderSizePixel = 0
    switchBtn.TextSize = 10
    switchBtn.Font = Enum.Font.GothamBold
    switchBtn.AutoButtonColor = false
    switchBtn.ZIndex = 317
    switchBtn.Parent = card

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(0, 14)
    switchCorner.Parent = switchBtn

    local stateKey = "Toggle_" .. titleText

    if ToggleStates[stateKey] == nil then
        ToggleStates[stateKey] = false
    end

    local state = ToggleStates[stateKey]

    local function refreshVisual(st)
        if st then
            switchBtn.Text = "ON"
            switchBtn.TextColor3 = GREEN
            switchBtn.BackgroundColor3 = ON_COLOR
        else
            switchBtn.Text = "OFF"
            switchBtn.TextColor3 = RED
            switchBtn.BackgroundColor3 = BUTTON
        end
    end

    refreshVisual(state)

    if state and callback then
        task.defer(function()
            if switchBtn.Parent then
                pcall(callback, true)
            end
        end)
    end

    switchBtn.MouseButton1Click:Connect(function()
        state = not state
        ToggleStates[stateKey] = state
        refreshVisual(state)

        if callback then
            task.spawn(function()
                pcall(callback, state)
            end)
        end
    end)
end

