local function saveWaypoints()
    if type(writefileFn) ~= "function" then
        return false
    end

    local success, json = pcall(function()
        return HttpService:JSONEncode(waypoints)
    end)

    if not success or type(json) ~= "string" then
        return false
    end

    local ok = pcall(function()
        writefileFn(WAYPOINT_FILE, json)
    end)

    return ok
end

local function loadWaypoints()
    waypoints = {}

    if type(readfileFn) ~= "function" then
        return false
    end

    if type(isfileFn) == "function" then
        local exists = false

        pcall(function()
            exists = isfileFn(WAYPOINT_FILE)
        end)

        if not exists then
            return false
        end
    end

    local success, fileData = pcall(function()
        return readfileFn(WAYPOINT_FILE)
    end)

    if not success or type(fileData) ~= "string" or fileData == "" then
        return false
    end

    local decodeSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(fileData)
    end)

    if not decodeSuccess or type(decoded) ~= "table" then
        return false
    end

    for name, pos in pairs(decoded) do
        if type(name) == "string"
            and type(pos) == "table"
            and tonumber(pos.X)
            and tonumber(pos.Y)
            and tonumber(pos.Z) then

            waypoints[name] = {
                X = tonumber(pos.X),
                Y = tonumber(pos.Y),
                Z = tonumber(pos.Z)
            }
        end
    end

    return true
end

