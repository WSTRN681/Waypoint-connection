            fpsDot.Position = UDim2.new(0, 6, 0.5, -3)
            fpsDot.BackgroundColor3 = ACCENT_GREEN
            fpsDot.BorderSizePixel = 0
            fpsDot.ZIndex = 10000000
            fpsDot.Parent = fpsCard

            local fpsDotCorner = Instance.new("UICorner")
            fpsDotCorner.CornerRadius = UDim.new(1, 0)
            fpsDotCorner.Parent = fpsDot

            local fpsLabel = Instance.new("TextLabel")
            fpsLabel.Name = "FPSLabel"
            fpsLabel.Size = UDim2.new(1, -16, 1, 0)
            fpsLabel.Position = UDim2.fromOffset(16, 0)
            fpsLabel.BackgroundTransparency = 1
            fpsLabel.Text = "-- FPS"
            fpsLabel.TextColor3 = TEXT_MAIN
            fpsLabel.TextSize = 10
            fpsLabel.Font = Enum.Font.GothamBold
            fpsLabel.TextXAlignment = Enum.TextXAlignment.Left
            fpsLabel.ZIndex = 10000000
            fpsLabel.Parent = fpsCard

            -- CARD PING
            local pingCard = Instance.new("Frame")
            pingCard.Name = "PingCard"
            pingCard.Size = UDim2.new(0.5, -6, 1, -8)
            pingCard.Position = UDim2.new(0.5, 2, 0, 4)
            pingCard.BackgroundColor3 = CARD_BG
            pingCard.BorderSizePixel = 0
            pingCard.ZIndex = 9999999
            pingCard.Parent = fpsHudFrame

            local pingCorner = Instance.new("UICorner")
            pingCorner.CornerRadius = UDim.new(0, 7)
            pingCorner.Parent = pingCard

            local pingDot = Instance.new("Frame")
            pingDot.Name = "PingDot"
            pingDot.Size = UDim2.fromOffset(6, 6)
            pingDot.Position = UDim2.new(0, 6, 0.5, -3)
            pingDot.BackgroundColor3 = ACCENT_GREEN
            pingDot.BorderSizePixel = 0
            pingDot.ZIndex = 10000000
            pingDot.Parent = pingCard

            local pingDotCorner = Instance.new("UICorner")
            pingDotCorner.CornerRadius = UDim.new(1, 0)
            pingDotCorner.Parent = pingDot

            local pingLabel = Instance.new("TextLabel")
            pingLabel.Name = "PingLabel"
            pingLabel.Size = UDim2.new(1, -16, 1, 0)
            pingLabel.Position = UDim2.fromOffset(16, 0)
            pingLabel.BackgroundTransparency = 1
            pingLabel.Text = "-- ms"
            pingLabel.TextColor3 = TEXT_MAIN
            pingLabel.TextSize = 10
            pingLabel.Font = Enum.Font.GothamBold
            pingLabel.TextXAlignment = Enum.TextXAlignment.Left
            pingLabel.ZIndex = 10000000
            pingLabel.Parent = pingCard

            enableDrag(fpsHudFrame, fpsHudFrame)
        end

        fpsHudFrame.Visible = true

        local lastUpdate = tick()
        local frameCount = 0

        fpsHudConn = RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
            local now = tick()
            if now - lastUpdate >= 0.4 then
                local elapsed = now - lastUpdate
                local fps = math.floor(frameCount / elapsed)
                frameCount = 0
                lastUpdate = now

                local ping = 0
                pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)

                local fpsCardObj = fpsHudFrame:FindFirstChild("FPSCard")
                local pingCardObj = fpsHudFrame:FindFirstChild("PingCard")

                if fpsCardObj then
                    local fpsLabel = fpsCardObj:FindFirstChild("FPSLabel")
                    local fpsDot = fpsCardObj:FindFirstChild("FPSDot")
                    if fpsLabel then fpsLabel.Text = string.format("%d FPS", fps) end
                    if fpsDot then
                        fpsDot.BackgroundColor3 = (fps < 30 and ACCENT_RED) or (fps < 50 and YELLOW) or ACCENT_GREEN
                    end
                end

                if pingCardObj then
                    local pingLabel = pingCardObj:FindFirstChild("PingLabel")
                    local pingDot = pingCardObj:FindFirstChild("PingDot")
                    if pingLabel then pingLabel.Text = string.format("%d ms", ping) end
                    if pingDot then
                        pingDot.BackgroundColor3 = (ping < 80 and ACCENT_GREEN) or (ping < 150 and YELLOW) or ACCENT_RED
                    end
                end
            end
        end)
    else
        if fpsHudConn then fpsHudConn:Disconnect() fpsHudConn = nil end
        if fpsHudFrame then fpsHudFrame.Visible = false end
    end
end)

