local function setPromptInstant(prompt)
    if prompt:IsA("ProximityPrompt") then
        if not originalDurations[prompt] then
            originalDurations[prompt] = prompt.HoldDuration
        end
        if fastInteractEnabled then
            prompt.HoldDuration = 0
        else
            if originalDurations[prompt] ~= nil then
                prompt.HoldDuration = originalDurations[prompt]
            end
        end
    end
end

local function applyFastInteractState()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        setPromptInstant(obj)
    end
end

