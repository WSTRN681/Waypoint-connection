local function FetchServerList(cursor)
    local url = "https://games.roblox.com/v1/games/" .. tostring(PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. tostring(cursor)
    end
    
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success and response and response ~= "" then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if decodeSuccess and decoded and decoded.data then
            return decoded.data, decoded.nextPageCursor
        end
    end
    return nil, nil
end

local function HopServer()
    if isHopInProcess then return end
    
    local target = tonumber(targetInput.Text)
    if not target then
        statusLabel.Text = "❌ Masukkan angka jumlah player!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    isHopInProcess = true
    target = math.clamp(target, 0, game.Players.MaxPlayers)
    
    statusLabel.Text = "🔍 Memindai server (Deep Scan)..."
    statusLabel.TextColor3 = YELLOW
    hopBtn.Text = "⏳ Mencari..."
    
    task.spawn(function()
        local validServers = {}
        local currentCursor = ""
        local pageLimit = 5
        local pagesFetched = 0
        
        while pagesFetched < pageLimit do
            pagesFetched = pagesFetched + 1
            local servers, nextCursor = FetchServerList(currentCursor)
            
            if servers then
                for _, server in ipairs(servers) do
                    local serverId = tostring(server.id)
                    local playing = tonumber(server.playing) or 0
                    local maxP = tonumber(server.maxPlayers) or 0
                    
                    if serverId ~= JobId and not blacklistedServers[serverId] then
                        local isMatch = false
                        if exactMatchActive then
                            isMatch = (playing == target)
                        else
                            isMatch = (playing <= target and playing < maxP)
                        end
                        
                        if isMatch then
                            table.insert(validServers, {id = serverId, playing = playing})
                        end
                    end
                end
            else
                break
            end
            
            if #validServers >= 3 or not nextCursor or nextCursor == "" then
                break
            end
            currentCursor = nextCursor
            task.wait(0.2)
        end
        
        if #validServers > 0 then
            math.randomseed(tick())
            local chosen = validServers[math.random(1, #validServers)]
            blacklistedServers[chosen.id] = true
            
            statusLabel.Text = "✅ Ditemukan! (" .. chosen.playing .. " player)"
            statusLabel.TextColor3 = GREEN
            hopBtn.Text = "🚀 Hop Sekali"
            
            saveCurrentServerAsPrevious()
            TeleportService:TeleportToPlaceInstance(PlaceId, chosen.id, Player)
        else
            if exactMatchActive then
                statusLabel.Text = "❌ Tidak ada server dengan " .. target .. " player"
            else
                statusLabel.Text = "❌ Server tak ditemukan / API limit"
            end
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            hopBtn.Text = "🚀 Hop Sekali"
        end
        
        isHopInProcess = false
    end)
end

local function startAutoHop()
    local target = tonumber(targetInput.Text)
    if not target then
        statusLabel.Text = "❌ Masukkan angka jumlah player!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
