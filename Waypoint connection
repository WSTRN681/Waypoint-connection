local function translateText(text, fromLang, toLang)
    if not text or text:gsub("%s+", "") == "" then return "" end

    local url = string.format(
        "https://translate.googleapis.com/translate_a/single?client=gtx&sl=%s&tl=%s&dt=t&q=%s",
        fromLang,
        toLang,
        HttpService:UrlEncode(text)
    )

    local success, response = pcall(function() return game:HttpGet(url) end)
    if success and response then
        local decodeSuccess, result = pcall(function() return HttpService:JSONDecode(response) end)
        if decodeSuccess and result and result[1] and result[1][1] then
            return result[1][1][1]
        end
    end

    return "Gagal menerjemahkan teks!"
end

