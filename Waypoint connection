local originalMaterials = {}
local originalShadows = Lighting.GlobalShadows

local function restoreGraphics()
    Lighting.GlobalShadows = originalShadows
    
    for part, originalMat in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = originalMat
        end
    end
    
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") then
            v.Enabled = true
        end
    end
    
    table.clear(originalMaterials)
end

-- 1. LOW GRAPHICS TOGGLE
createToggleRow(graphicsPage, "📉 Low Graphics", "Mode Anti-Lag (Material Smooth)", 5, function(isOn)
    if isOn then
        originalShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
        
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                if not originalMaterials[v] then
                    originalMaterials[v] = v.Material
                end
                v.Material = Enum.Material.SmoothPlastic
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                v.Enabled = false
            end
        end
    else
        restoreGraphics()
    end
end)

