local function HopServer()
    local target = tonumber(targetInput.Text) or 5
    target = math.clamp(target, 0, game.Players.MaxPlayers)
    
    statusLabel.Text = "🔍 Searching server..."
    statusLabel.TextColor3 = YELLOW
    hopBtn.Text = "⏳ Searching..."
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    
    if success and result and result.data then
        local found = false
        for _, server in ipairs(result.data) do
            if server.id ~= JobId and server.playing <= target and server.playing < server.maxPlayers then
                found = true
                statusLabel.Text = "✅ Found! (" .. server.playing .. " players)"
                statusLabel.TextColor3 = GREEN
                hopBtn.Text = "🚀 Hop Sekali"
                TeleportService:TeleportToPlaceInstance(PlaceId, server.id, Player)
                return
            end
        end
        
        if not found then
            statusLabel.Text = "❌ No server found with ≤ " .. target .. " players"
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            hopBtn.Text = "🚀 Hop Sekali"
        end
    else
        statusLabel.Text = "❌ Failed to get server data!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        hopBtn.Text = "🚀 Hop Sekali"
    end
end

local function startAutoHop()
    if isAutoHoping then return end
    isAutoHoping = true
    autoHopRunning = true
    autoHopBtn.Text = "🔁 Auto: ON"
    autoHopBtn.BackgroundColor3 = ON_COLOR
    stopAutoBtn.Visible = true
    statusLabel.Text = "🔄 Auto Hop aktif..."
    statusLabel.TextColor3 = YELLOW

    task.spawn(function()
        while autoHopRunning do
            local target = tonumber(targetInput.Text) or 5
            target = math.clamp(target, 0, game.Players.MaxPlayers)
            
            if #Players:GetPlayers() > target then
                HopServer()
                task.wait(2)
            else
                statusLabel.Text = "🔄 Player count normal (" .. #Players:GetPlayers() .. " ≤ " .. target .. ")"
                statusLabel.TextColor3 = SUBTEXT
            end
            task.wait(3)
        end
    end)
end

local function stopAutoHop()
    autoHopRunning = false
    isAutoHoping = false
    autoHopBtn.Text = "🔁 Auto: OFF"
    autoHopBtn.BackgroundColor3 = BUTTON
    stopAutoBtn.Visible = false
    statusLabel.Text = "Status: ✅ Siap"
    statusLabel.TextColor3 = SUBTEXT
end

