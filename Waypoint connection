-- ============================================================
-- ADD WAYPOINT
-- ============================================================
addBtn.MouseButton1Click:Connect(function()
    local char = Player.Character
    if not char then
        addBtn.Text = "⏳"
        addBtn.BackgroundColor3 = YELLOW
        Player.CharacterAdded:Wait()
        addBtn.Text = "➕ Add Waypoint"
        addBtn.BackgroundColor3 = CATEGORY_SELECTED
        addBtn.MouseButton1Click:Fire()
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        addBtn.Text = "⚠️"
        addBtn.BackgroundColor3 = RED
        task.wait(1)
        addBtn.Text = "➕ Add Waypoint"
        addBtn.BackgroundColor3 = CATEGORY_SELECTED
        return
    end

    local pos = root.Position
    wpCounter = wpCounter + 1
    table.insert(waypoints, {
        n = "WP " .. wpCounter,
        X = pos.X,
        Y = pos.Y,
        Z = pos.Z
    })
    saveData()
    refreshWaypoint()
    addBtn.Text = "✅"
    addBtn.BackgroundColor3 = GREEN
    task.wait(0.5)
    addBtn.Text = "➕ Add Waypoint"
    addBtn.BackgroundColor3 = CATEGORY_SELECTED
end)

-- ============================================================
-- LOAD & INIT
-- ============================================================
loadData()
refreshWaypoint()
