    sw.AutoButtonColor = false
    sw.ZIndex = 118
    sw.Parent = card

    local swCorner = Instance.new("UICorner")
    swCorner.CornerRadius = UDim.new(0, 11)
    swCorner.Parent = sw

    local stateKey = "Toggle_" .. titleText
    if ToggleStates[stateKey] == nil then
        ToggleStates[stateKey] = false
    end
    local state = ToggleStates[stateKey]

    local function refreshVisual(st)
        sw.Text = st and "ON" or "OFF"
        sw.TextColor3 = st and ACCENT_GREEN or ACCENT_RED
        sw.BackgroundColor3 = st and ACCENT_BLUE or BUTTON_BG
    end

    refreshVisual(state)

    if state and callback then
        task.spawn(function() callback(true) end)
    end

    sw.MouseButton1Click:Connect(function()
        state = not state
        ToggleStates[stateKey] = state
        refreshVisual(state)
        showToast(titleText, state and "Status: Enabled" or "Status: Disabled", state and ACCENT_GREEN or ACCENT_RED)
        if callback then task.spawn(function() callback(state) end) end
    end)
end

