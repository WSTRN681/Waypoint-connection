        delBtn.Parent = row

        local delCorner = Instance.new("UICorner")
        delCorner.CornerRadius = UDim.new(0, 6)
        delCorner.Parent = delBtn

        tpBtn.MouseButton1Click:Connect(function()
            local root = getRoot()
            if root and pos then
                root.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
            end
        end)

        editBtn.MouseButton1Click:Connect(function()
            if row:FindFirstChild("RenameInput") then return end

            local renameInput = Instance.new("TextBox")
            renameInput.Name = "RenameInput"
            renameInput.Size = UDim2.new(1, -135, 0, 30)
            renameInput.Position = UDim2.fromOffset(8, 7)
            renameInput.BackgroundColor3 = BG
            renameInput.BorderSizePixel = 0
            renameInput.Text = name
            renameInput.TextColor3 = TEXT
            renameInput.TextSize = 12
            renameInput.Font = Enum.Font.GothamBold
            renameInput.ZIndex = 525
            renameInput.Parent = row

            local rCorner = Instance.new("UICorner")
            rCorner.CornerRadius = UDim.new(0, 6)
            rCorner.Parent = renameInput

            label.Visible = false

            renameInput.FocusLost:Connect(function(enterPressed)
                local newName = renameInput.Text:gsub("^%s*(.-)%s*$", "%1")
                if newName ~= "" and newName ~= name then
                    waypoints[newName] = waypoints[name]
                    waypoints[name] = nil
                    saveWaypoints()
                end
                refreshWaypointList()
            end)
            renameInput:CaptureFocus()
        end)

        delBtn.MouseButton1Click:Connect(function()
            waypoints[name] = nil
            saveWaypoints()
            refreshWaypointList()
        end)
    end

    if count == 0 then
        emptyLabel.Visible = true
    else
        emptyLabel.Visible = false
    end

    task.wait()
    local contentHeight = math.max(wayLayout.AbsoluteContentSize.Y, 50)
    wayList.Size = UDim2.new(1, -10, 0, contentHeight)
