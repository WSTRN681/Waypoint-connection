local tracerEspActive = false
local tracerConn = nil
local activeTracers = {}

local function removeDrawing(obj)
    if not obj then
        return
    end

    pcall(function()
        if type(obj.Remove) == "function" then
            obj:Remove()
        elseif type(obj.Destroy) == "function" then
            obj:Destroy()
        end
    end)
end

local function removeTracer(target)
    local data = activeTracers[target]

    if data then
        removeDrawing(data.Box)
        removeDrawing(data.Line)
        activeTracers[target] = nil
    end
end

local function createTracerObjects()
    if type(DrawingLib) ~= "table"
        or type(DrawingLib.new) ~= "function" then
        return nil
    end

    local success, box = pcall(function()
        return DrawingLib.new("Square")
    end)

    if not success or not box then
        return nil
    end

    local lineSuccess, line = pcall(function()
        return DrawingLib.new("Line")
    end)

    if not lineSuccess or not line then
        removeDrawing(box)
        return nil
    end

    pcall(function()
        box.Visible = false
        box.Color = Color3.fromRGB(255, 50, 50)
        box.Thickness = 1.5
        box.Filled = false
    end)

    pcall(function()
        line.Visible = false
        line.Color = Color3.fromRGB(255, 50, 50)
        line.Thickness = 1.5
    end)

    return {
        Box = box,
        Line = line
    }
end

createToggleRow(
    interactPage,
    "📦 Box & Tracer ESP",
    "Kotak & Garis dari tengah atas ke player",
    170,
    function(isOn)
        tracerEspActive = isOn

        if tracerConn then
            tracerConn:Disconnect()
            tracerConn = nil
        end

        if not isOn then
            for _, p in ipairs(Players:GetPlayers()) do
                removeTracer(p)
            end

            return
        end

        if type(DrawingLib) ~= "table"
            or type(DrawingLib.new) ~= "function" then

            tracerEspActive = false
            ToggleStates["Toggle_📦 Box & Tracer ESP"] = false
            return
        end

        tracerConn = RunService.RenderStepped:Connect(function()
            if not tracerEspActive then
                return
            end

            local currentCamera = getCamera()

            if not currentCamera then
                return
            end

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= Player and p.Character then
                    local char = p.Character
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")

                    if root and hum and hum.Health > 0 then
                        local screenPos, onScreen =
                            currentCamera:WorldToViewportPoint(root.Position)

                        if onScreen then
                            if not activeTracers[p] then
                                activeTracers[p] = createTracerObjects()
                            end

                            local data = activeTracers[p]

                            if data then
                                local head = char:FindFirstChild("Head")

                                if head then
                                    local topScreen, topOnScreen =
                                        currentCamera:WorldToViewportPoint(
                                            head.Position + Vector3.new(0, 0.8, 0)
                                        )

                                    local botScreen, botOnScreen =
                                        currentCamera:WorldToViewportPoint(
                                            root.Position - Vector3.new(0, 3, 0)
                                        )

                                    if topOnScreen or botOnScreen then
                                        local height =
                                            math.abs(topScreen.Y - botScreen.Y)

                                        local width =
                                            math.max(height * 0.6, 2)

                                        pcall(function()
                                            data.Box.Size =
                                                Vector2.new(width, height)

                                            data.Box.Position =
                                                Vector2.new(
                                                    topScreen.X - width / 2,
                                                    topScreen.Y
                                                )

                                            data.Box.Visible = true

                                            data.Line.From =
                                                Vector2.new(
                                                    currentCamera.ViewportSize.X / 2,
                                                    0
                                                )

                                            data.Line.To =
                                                Vector2.new(
                                                    topScreen.X,
                                                    topScreen.Y
                                                )

                                            data.Line.Visible = true
                                        end)
                                    else
                                        pcall(function()
                                            data.Box.Visible = false
                                            data.Line.Visible = false
                                        end)
                                    end
                                else
                                    pcall(function()
                                        data.Box.Visible = false
                                        data.Line.Visible = false
                                    end)
                                end
                            end
                        elseif activeTracers[p] then
                            pcall(function()
                                activeTracers[p].Box.Visible = false
                                activeTracers[p].Line.Visible = false
                            end)
                        end
                    elseif activeTracers[p] then
                        pcall(function()
                            activeTracers[p].Box.Visible = false
                            activeTracers[p].Line.Visible = false
                        end)
                    end
                else
                    removeTracer(p)
                end
            end
        end)
    end
)

