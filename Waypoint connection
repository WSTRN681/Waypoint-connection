local function fetchServers()
    local servers = {}
    local cursor = nil
    local pagesChecked = 0

    repeat
        pagesChecked = pagesChecked + 1

        local url =
            "https://games.roblox.com/v1/games/" ..
            tostring(PlaceId) ..
            "/servers/Public?sortOrder=Asc&limit=100"

        if cursor and cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, response = pcall(function()
            local httpGet = getOptional("httpget")

            if type(httpGet) == "function" then
                return httpGet(url)
            end

            if type(game.HttpGet) == "function" then
                return game:HttpGet(url)
            end

            return nil
        end)

        if not ok or type(response) ~= "string" then
            break
        end

        local decodeOk, result = pcall(function()
            return HttpService:JSONDecode(response)
        end)

        if not decodeOk
            or type(result) ~= "table"
            or type(result.data) ~= "table" then
            break
        end

        for _, server in ipairs(result.data) do
            if type(server) == "table"
                and server.id
                and server.playing ~= nil
                and server.maxPlayers ~= nil then

                table.insert(servers, server)
            end
        end

        cursor = result.nextPageCursor
    until not cursor or cursor == "" or pagesChecked >= 5

    return servers
end

local function chooseServer(servers, target)
    local emptyServers = {}
    local validServers = {}

    for _, server in ipairs(servers) do
        if server.id ~= JobId
            and server.playing < server.maxPlayers then

            if server.playing == 0 then
                table.insert(emptyServers, server)
            end

            if server.playing <= target then
                table.insert(validServers, server)
            end
        end
    end

    if #emptyServers > 0 then
        return emptyServers[math.random(1, #emptyServers)], true
    end

    if #validServers > 0 then
        return validServers[math.random(1, #validServers)], false
    end

    return nil, false
end

local function teleportToServer(placeId, serverId)
    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            placeId,
            serverId,
            Player
        )
    end)

    if not ok then
        statusLabel.Text = "❌ Teleport gagal"
        statusLabel.TextColor3 = RED
        hopBtn.Text = "🚀 Hop Sekali"
        hopInProgress = false
        return false
    end

    return true
end

local function HopServer()
    if hopInProgress then
        return
    end

    local target = tonumber(targetInput.Text)

    if not target then
        statusLabel.Text = "❌ Masukkan angka jumlah player!"
        statusLabel.TextColor3 = RED
        return
    end

    target = math.clamp(
        math.floor(target),
        0,
        Players.MaxPlayers
    )

    hopInProgress = true

    statusLabel.Text = "🔍 Mencari server kosong..."
    statusLabel.TextColor3 = YELLOW
    hopBtn.Text = "⏳ Mencari..."

    task.spawn(function()
        local servers = fetchServers()

        if #servers == 0 then
            statusLabel.Text = "❌ Gagal memuat daftar server!"
            statusLabel.TextColor3 = RED
            hopBtn.Text = "🚀 Hop Sekali"
            hopInProgress = false
            return
        end

        local chosenServer, isEmpty =
            chooseServer(servers, target)

        if not chosenServer then
            statusLabel.Text =
                "❌ Tidak ada server ≤ " ..
                tostring(target)

            statusLabel.TextColor3 = RED
            hopBtn.Text = "🚀 Hop Sekali"
            hopInProgress = false
            return
        end

        GlobalEnv.STRN_PreviousJobId = JobId
        GlobalEnv.STRN_LastPlaceId = PlaceId

        if isEmpty then
            statusLabel.Text =
                "✅ Server 0 player ditemukan!"
        else
            statusLabel.Text =
                "✅ Server " ..
                tostring(chosenServer.playing) ..
                " player ditemukan!"
        end

        statusLabel.TextColor3 = GREEN
        hopBtn.Text = "🚀 Hop Sekali"

        teleportToServer(
            PlaceId,
            chosenServer.id
        )
    end)
end

local function startAutoHop()
    local target = tonumber(targetInput.Text)

    if not target then
        statusLabel.Text = "❌ Masukkan angka jumlah player!"
        statusLabel.TextColor3 = RED
        return
    end

    if isAutoHoping then
        return
    end

    isAutoHoping = true
    autoHopRunning = true

    autoHopBtn.Text = "🔁 Auto: ON"
    autoHopBtn.BackgroundColor3 = ON_COLOR
    stopAutoBtn.Visible = true

    statusLabel.Text = "🔄 Auto Hop aktif..."
    statusLabel.TextColor3 = YELLOW

    task.spawn(function()
        while autoHopRunning do
            local currentTarget =
                tonumber(targetInput.Text) or 5

            currentTarget = math.clamp(
                math.floor(currentTarget),
                0,
                Players.MaxPlayers
            )

            if #Players:GetPlayers() > currentTarget then
                HopServer()
                task.wait(5)
            else
                statusLabel.Text =
                    "🔄 Normal (" ..
                    #Players:GetPlayers() ..
                    " ≤ " ..
                    currentTarget ..
                    ")"

                statusLabel.TextColor3 = SUBTEXT
            end

            task.wait(3)
        end
    end)
end

local function stopAutoHop()
    autoHopRunning = false
    isAutoHoping = false
    hopInProgress = false

    autoHopBtn.Text = "🔁 Auto: OFF"
    autoHopBtn.BackgroundColor3 = BUTTON
    stopAutoBtn.Visible = false

    statusLabel.Text = "Status: ✅ Siap"
    statusLabel.TextColor3 = SUBTEXT
end

