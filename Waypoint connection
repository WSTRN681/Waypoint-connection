-- 2. HIDE OTHER PLAYERS
local hidePlayersActive = false
local hidePlayersConn = nil
local playerAddedConns = {}
local childAddedConns = {}

local function setPartTransparency(part, transparencyValue)
    if part:IsA("BasePart") or part:IsA("Decal") then
        part.Transparency = transparencyValue
    elseif part:IsA("ParticleEmitter") or part:IsA("Sparkles") or part:IsA("Fire") or part:IsA("Beam") or part:IsA("Trail") then
        part.Enabled = (transparencyValue == 0)
    end
end

local function applyHideToCharacter(character, hide)
    if not character then return end
    local transVal = hide and 1 or 0
    for _, part in ipairs(character:GetDescendants()) do
        if part.Name ~= "HumanoidRootPart" then setPartTransparency(part, transVal) end
    end
end

local function monitorCharacterAccessories(character)
    if not character then return end
    local conn = character.ChildAdded:Connect(function(child)
        if hidePlayersActive then
            task.wait(0.1)
            applyHideToCharacter(child, true)
            for _, descendant in ipairs(child:GetDescendants()) do setPartTransparency(descendant, 1) end
        end
    end)
    table.insert(childAddedConns, conn)
end

local function toggleHidePlayers(state)
    hidePlayersActive = state
    if hidePlayersConn then hidePlayersConn:Disconnect() hidePlayersConn = nil end
    for _, conn in ipairs(playerAddedConns) do conn:Disconnect() end
    for _, conn in ipairs(childAddedConns) do conn:Disconnect() end
    table.clear(playerAddedConns)
    table.clear(childAddedConns)

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= Player and targetPlayer.Character then
            applyHideToCharacter(targetPlayer.Character, hidePlayersActive)
            if hidePlayersActive then monitorCharacterAccessories(targetPlayer.Character) end
        end
    end

    if hidePlayersActive then
        local function onCharAdded(targetPlayer, char)
            if not hidePlayersActive then return end
            applyHideToCharacter(char, true)
            monitorCharacterAccessories(char)
            task.spawn(function()
                task.wait(0.5)
                if hidePlayersActive and char and char.Parent then applyHideToCharacter(char, true) end
                task.wait(1.5)
                if hidePlayersActive and char and char.Parent then applyHideToCharacter(char, true) end
            end)
        end

        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= Player then
                local conn = targetPlayer.CharacterAdded:Connect(function(char) onCharAdded(targetPlayer, char) end)
                table.insert(playerAddedConns, conn)
            end
        end

        hidePlayersConn = Players.PlayerAdded:Connect(function(targetPlayer)
            local conn = targetPlayer.CharacterAdded:Connect(function(char) onCharAdded(targetPlayer, char) end)
            table.insert(playerAddedConns, conn)
        end)
    end
end

