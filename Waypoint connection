saveBtn.MouseButton1Click:Connect(function()
    local root = getRoot()
    if not root then return end

    local inputName = nameInput.Text
    if not inputName or inputName:gsub("%s+", "") == "" then
        local count = 0
        for _ in pairs(waypoints) do count = count + 1 end
        inputName = "Posisi_" .. tostring(count + 1)
    end

    waypoints[inputName] = {
        X = root.CFrame.X,
        Y = root.CFrame.Y,
        Z = root.CFrame.Z
    }

    nameInput.Text = ""
    saveWaypoints()
    refreshWaypointList()
end)

