        empty.TextColor3 = SUBTEXT
        empty.TextSize = 13
        empty.Font = Enum.Font.Gotham
        empty.TextXAlignment = Enum.TextXAlignment.Center
        empty.ZIndex = 116
        empty.Parent = listFrame
        listFrame.Size = UDim2.new(1, -20, 0, 60)
        waypointPage.CanvasSize = UDim2.new(0, 0, 0, 120)
        return
