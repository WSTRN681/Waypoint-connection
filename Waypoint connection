-- ============================================================
-- DATA
-- ============================================================
local waypoints = {}
local wpCounter = 0

local function saveData()
    local data = { waypoints = waypoints, counter = wpCounter }
    local json = HttpService:JSONEncode(data)
    pcall(function() HttpService:SetAsync(CONFIG_KEY, json) end)
end

local function loadData()
    local success, json = pcall(function() return HttpService:GetAsync(CONFIG_KEY) end)
    if success and json then
        local data = HttpService:JSONDecode(json)
        if data and data.waypoints then
            waypoints = data.waypoints
            wpCounter = data.counter or #waypoints
            return true
        end
    end
    return false
end

