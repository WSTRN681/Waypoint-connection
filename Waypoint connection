            if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("BloomEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
                if v.Enabled then
                    table.insert(disabledEffectsList, v)
                    v.Enabled = false
                end
            end
        end
    else
