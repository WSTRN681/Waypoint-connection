-- FUNGSI PERGANTIAN TAB
local isSwitchingTab = false
local function switchTab(selectedPage, selectedBtn)
    if isSwitchingTab or selectedPage.Visible then return end
    isSwitchingTab = true

    waypointTabBtn.BackgroundColor3 = BUTTON
    interactTabBtn.BackgroundColor3 = BUTTON
    hopTabBtn.BackgroundColor3 = BUTTON
    graphicsTabBtn.BackgroundColor3 = BUTTON

    selectedBtn.BackgroundColor3 = ON_COLOR

    local pages = {waypointPage, interactPage, hopPage, graphicsPage}
    for _, p in ipairs(pages) do
        if p.Visible then
            local tOut = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(p, tOut, {Position = UDim2.fromOffset(10, 105)}):Play()
            task.wait(0.1)
            p.Visible = false
        end
    end

    selectedPage.Position = UDim2.fromOffset(10, 75)
    selectedPage.Visible = true
    local tIn = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tTween = TweenService:Create(selectedPage, tIn, {Position = UDim2.fromOffset(10, 90)})
    tTween:Play()
    tTween.Completed:Connect(function()
        isSwitchingTab = false
    end)
end

