            pingDot.Size = UDim2.fromOffset(6, 6)
            pingDot.Position = UDim2.new(0, 8, 0.5, -3)
            pingDot.BackgroundColor3 = GREEN
            pingDot.BorderSizePixel = 0
            pingDot.ZIndex = 10000000
            pingDot.Parent = pingCard

            local pingDotCorner = Instance.new("UICorner")
            pingDotCorner.CornerRadius = UDim.new(1, 0)
            pingDotCorner.Parent = pingDot

            local pingLabel = Instance.new("TextLabel")
            pingLabel.Name = "PingLabel"
            pingLabel.Size = UDim2.new(1, -20, 1, 0)
            pingLabel.Position = UDim2.fromOffset(18, 0)
            pingLabel.BackgroundTransparency = 1
            pingLabel.Text = "-- ms"
            pingLabel.TextColor3 = TEXT
            pingLabel.TextSize = 11
            pingLabel.Font = Enum.Font.GothamBold
            pingLabel.TextXAlignment = Enum.TextXAlignment.Left
            pingLabel.ZIndex = 10000000
            pingLabel.Parent = pingCard

            -- DRAGGING LOGIC UNTUK HUD DISPLAY
            local isDraggingHud = false
            local dragStartPos, dragStartMouse

            fpsHudFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDraggingHud = true
                    dragStartPos = fpsHudFrame.Position
                    dragStartMouse = UserInputService:GetMouseLocation()
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if isDraggingHud and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local delta = UserInputService:GetMouseLocation() - dragStartMouse
                    fpsHudFrame.Position = UDim2.new(
                        dragStartPos.X.Scale,
                        dragStartPos.X.Offset + delta.X,
                        dragStartPos.Y.Scale,
                        dragStartPos.Y.Offset + delta.Y
                    )
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDraggingHud = false
                end
            end)
        end

        fpsHudFrame.Visible = true

        local lastUpdate = tick()
        local frameCount = 0

        fpsHudConn = RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
            local now = tick()

            if now - lastUpdate >= 0.4 then
                local elapsed = now - lastUpdate
                local fps = math.floor(frameCount / elapsed)
                frameCount = 0
                lastUpdate = now

                local ping
                local pingSuccess, pingValue = pcall(function()
                    return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                if pingSuccess then ping = tonumber(pingValue) end

                local fpsCardObj = fpsHudFrame:FindFirstChild("FPSCard")
                local pingCardObj = fpsHudFrame:FindFirstChild("PingCard")

                if fpsCardObj then
                    local fpsLabel = fpsCardObj:FindFirstChild("FPSLabel")
                    local fpsDot = fpsCardObj:FindFirstChild("FPSDot")

                    if fpsLabel then fpsLabel.Text = string.format("%d FPS", fps) end
                    if fpsDot then
                        if fps < 30 then
                            fpsDot.BackgroundColor3 = RED
                        elseif fps < 50 then
                            fpsDot.BackgroundColor3 = YELLOW
                        else
                            fpsDot.BackgroundColor3 = GREEN
                        end
                    end
                end

                if pingCardObj then
                    local pingLabel = pingCardObj:FindFirstChild("PingLabel")
                    local pingDot = pingCardObj:FindFirstChild("PingDot")

                    if ping then
                        if pingLabel then pingLabel.Text = string.format("%d ms", math.floor(ping)) end
                        if pingDot then
                            if ping < 80 then
                                pingDot.BackgroundColor3 = GREEN
                            elseif ping < 150 then
                                pingDot.BackgroundColor3 = YELLOW
                            else
                                pingDot.BackgroundColor3 = RED
                            end
                        end
                    else
                        if pingLabel then pingLabel.Text = "-- ms" end
                    end
                end
            end
        end)
    else
        if fpsHudConn then
            fpsHudConn:Disconnect()
            fpsHudConn = nil
        end
        if fpsHudFrame then
            fpsHudFrame.Visible = false
        end
    end
end)

