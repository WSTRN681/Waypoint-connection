local function FetchServerList(cursor)
    local url = "https://games.roblox.com/v1/games/" .. tostring(PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor and cursor ~= "" then url = url .. "&cursor=" .. tostring(cursor) end
    local success, response = pcall(function() return game:HttpGet(url) end)
    if success and response and response ~= "" then
        local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(response) end)
        if decodeSuccess and decoded and decoded.data then return decoded.data, decoded.nextPageCursor end
    end
    return nil, nil
end

local function HopServer()
    if isHopInProcess then return end
    local target = tonumber(targetInput.Text)
    if not target then
        statusLabel.Text = "❌ Masukkan angka jumlah player!"
        statusLabel.TextColor3 = ACCENT_RED
        showToast("Server Hop", "Masukkan angka jumlah player!", ACCENT_RED)
        return
    end

    isHopInProcess = true
    target = math.clamp(target, 0, game.Players.MaxPlayers)

    statusLabel.Text = "🔍 Memindai server (Deep Scan)..."
    statusLabel.TextColor3 = YELLOW
    hopBtn.Text = "⏳ Mencari..."
    showToast("Server Hop", "Memindai daftar server...", ACCENT_BLUE)

    task.spawn(function()
        local validServers = {}
        local currentCursor = ""
        local pagesFetched = 0
        while pagesFetched < 5 do
            pagesFetched = pagesFetched + 1
            local servers, nextCursor = FetchServerList(currentCursor)
            if servers then
                for _, server in ipairs(servers) do
                    local serverId = tostring(server.id)
                    local playing = tonumber(server.playing) or 0
                    local maxP = tonumber(server.maxPlayers) or 0
                    if serverId ~= JobId and not blacklistedServers[serverId] then
                        local isMatch = exactMatchActive and (playing == target) or (playing <= target and playing < maxP)
                        if isMatch then table.insert(validServers, {id = serverId, playing = playing}) end
                    end
                end
            else break end
            if #validServers >= 3 or not nextCursor or nextCursor == "" then break end
            currentCursor = nextCursor
            task.wait(0.2)
        end

        if #validServers > 0 then
            math.randomseed(tick())
            local chosen = validServers[math.random(1, #validServers)]
            blacklistedServers[chosen.id] = true
            statusLabel.Text = "✅ Ditemukan! (" .. chosen.playing .. " player)"
            statusLabel.TextColor3 = ACCENT_GREEN
            hopBtn.Text = "🚀 Hop Sekali"
            showToast("Server Hop", "Melakukan Teleport...", ACCENT_GREEN)
            saveCurrentServerAsPrevious()
            TeleportService:TeleportToPlaceInstance(PlaceId, chosen.id, Player)
        else
            statusLabel.Text = exactMatchActive and ("❌ Tidak ada server dengan " .. target .. " player") or "❌ Server tak ditemukan"
            statusLabel.TextColor3 = ACCENT_RED
            hopBtn.Text = "🚀 Hop Sekali"
            showToast("Server Hop", "Server tak ditemukan!", ACCENT_RED)
        end
        isHopInProcess = false
    end)
end

local function startAutoHop()
    local target = tonumber(targetInput.Text)
    if not target then
        statusLabel.Text = "❌ Masukkan angka jumlah player!"
        statusLabel.TextColor3 = ACCENT_RED
        showToast("Auto Hop", "Masukkan angka jumlah player!", ACCENT_RED)
        return
    end
    if isAutoHoping then return end
    isAutoHoping = true
    autoHopRunning = true
    autoHopBtn.Text = "🔁 Auto: ON"
    autoHopBtn.BackgroundColor3 = ACCENT_BLUE
    stopAutoBtn.Visible = true
    statusLabel.Text = "🔄 Auto Hop aktif..."
    statusLabel.TextColor3 = YELLOW
    showToast("Auto Hop", "Fitur Auto Hop Diaktifkan", ACCENT_GREEN)

    task.spawn(function()
        while autoHopRunning do
            local currentTarget = tonumber(targetInput.Text) or 5
            currentTarget = math.clamp(currentTarget, 0, game.Players.MaxPlayers)
            local shouldHop = exactMatchActive and (#Players:GetPlayers() ~= currentTarget) or (#Players:GetPlayers() > currentTarget)

