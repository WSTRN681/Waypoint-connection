-- 1. NAME ESP
local nameEspActive = false
local nameEspConn = nil
local nameBillboards = {}

local function removeNameESP(target)
    if nameBillboards[target] then
        pcall(function() nameBillboards[target]:Destroy() end)
        nameBillboards[target] = nil
    end
end

local function addNameESP(target)
    removeNameESP(target)
    if target == Player then return end

    local function setupChar(char)
        removeNameESP(target)
        local head = char:WaitForChild("Head", 3)
        if not head then return end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "STRN_NameESP"
        billboard.Adornee = head
        billboard.Size = UDim2.fromOffset(100, 30)
        billboard.StudsOffset = Vector3.new(0, 1.8, 0)
        billboard.AlwaysOnTop = true
        billboard.ZIndexBehavior = Enum.ZIndexBehavior.Global
        billboard.Parent = head

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = target.DisplayName or target.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextSize = 11
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextStrokeTransparency = 0.1
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = billboard

        nameBillboards[target] = billboard
    end

    if target.Character then setupChar(target.Character) end
    target.CharacterAdded:Connect(setupChar)
end

