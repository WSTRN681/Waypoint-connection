                if obj:IsA("ProximityPrompt") then
                    if promptOriginalDurations[obj] == nil then
                        promptOriginalDurations[obj] = obj.HoldDuration
                    end

                    obj.HoldDuration = 0
                end
            end

            autoPromptConn = workspace.DescendantAdded:Connect(function(obj)
                if obj:IsA("ProximityPrompt") then
                    if promptOriginalDurations[obj] == nil then
                        promptOriginalDurations[obj] = obj.HoldDuration
                    end

                    obj.HoldDuration = 0
                end
            end)
        else
            for prompt, duration in pairs(promptOriginalDurations) do
                if prompt and prompt.Parent then
                    pcall(function()
                        prompt.HoldDuration = duration
                    end)
                end
            end

            table.clear(promptOriginalDurations)
        end
    end
)

