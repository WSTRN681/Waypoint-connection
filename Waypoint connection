createToggleRow(
    graphicsPage,
    "📊 FPS & Ping Display",
    "Tampilkan statistik FPS & Ping di layar",
    144,
    function(isOn)
        if fpsHudConn then
            fpsHudConn:Disconnect()
            fpsHudConn = nil
        end

        if not isOn then
            if fpsHudFrame then
                fpsHudFrame.Visible = false
            end

            return
        end

        createFpsHud()
        fpsHudFrame.Visible = true

        local lastUpdate = tick()
        local frameCount = 0

        fpsHudConn = RunService.RenderStepped:Connect(function()
            if not fpsHudFrame
                or not fpsHudFrame.Parent
                or not fpsHudFrame.Visible then
                return
            end

            frameCount = frameCount + 1

            local now = tick()

            if now - lastUpdate >= 0.5 then
                local elapsed = now - lastUpdate
                local fps = math.floor(frameCount / elapsed)

                frameCount = 0
                lastUpdate = now

                local ping

                local pingSuccess, pingValue = pcall(function()
                    return Stats.Network.ServerStatsItem[
                        "Data Ping"
                    ]:GetValue()
                end)

                if pingSuccess then
                    ping = tonumber(pingValue)
                end

                local fpsLbl =
                    fpsHudFrame:FindFirstChild("FPSLabel")

                local pingLbl =
                    fpsHudFrame:FindFirstChild("PingLabel")

                if fpsLbl then
                    fpsLbl.Text =
                        string.format("FPS: %d", fps)

                    if fps < 30 then
                        fpsLbl.TextColor3 = RED
                    elseif fps < 50 then
                        fpsLbl.TextColor3 = YELLOW
                    else
                        fpsLbl.TextColor3 = GREEN
                    end
                end

                if pingLbl then
                    if ping then
                        pingLbl.Text =
                            string.format(
                                "Ping: %dms",
                                math.floor(ping)
                            )

                        if ping < 80 then
                            pingLbl.TextColor3 = GREEN
                        elseif ping < 150 then
                            pingLbl.TextColor3 = YELLOW
                        else
                            pingLbl.TextColor3 = RED
                        end
                    else
                        pingLbl.Text = "Ping: -- ms"
                        pingLbl.TextColor3 = SUBTEXT
                    end
                end
            end
        end)
    end
)

