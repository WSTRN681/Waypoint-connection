            local currentTarget = tonumber(targetInput.Text) or 5
            currentTarget = math.clamp(currentTarget, 0, game.Players.MaxPlayers)
            
            local shouldHop = false
            if exactMatchActive then
                shouldHop = (#Players:GetPlayers() ~= currentTarget)
            else
                shouldHop = (#Players:GetPlayers() > currentTarget)
