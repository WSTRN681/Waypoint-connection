-- STORAGE FILE WAYPOINT & LAST SERVER (PER-GAME VIA PLACEID)
local PlaceId = game.PlaceId
local JobId = game.JobId
local WAYPOINT_FILE = "STRN_Waypoint_" .. tostring(PlaceId) .. ".json"
local LAST_SERVER_FILE = "STRN_LastServer_" .. tostring(PlaceId) .. ".json"
local waypoints = {}
local previousJobId = nil
local blacklistedServers = {[JobId] = true}

local function saveWaypoints()
    local success, json = pcall(function() return HttpService:JSONEncode(waypoints) end)
    if success and json and writefile then
        pcall(function() writefile(WAYPOINT_FILE, json) end)
    end
end

local function loadWaypoints()
    if isfile and not isfile(WAYPOINT_FILE) then return end
    if readfile then
        local success, fileData = pcall(function() return readfile(WAYPOINT_FILE) end)
        if success and fileData and fileData ~= "" then
            local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(fileData) end)
            if decodeSuccess and type(decoded) == "table" then
                waypoints = decoded
            end
        end
    end
end

local function saveCurrentServerAsPrevious()
    if writefile and JobId and JobId ~= "" then
        pcall(function()
            writefile(LAST_SERVER_FILE, HttpService:JSONEncode({jobId = JobId}))
        end)
    end
end

local function loadPreviousServer()
    if isfile and isfile(LAST_SERVER_FILE) and readfile then
        local success, fileData = pcall(function() return readfile(LAST_SERVER_FILE) end)
        if success and fileData and fileData ~= "" then
            local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(fileData) end)
            if decodeSuccess and type(decoded) == "table" and decoded.jobId then
                if decoded.jobId ~= JobId then
                    previousJobId = decoded.jobId
                end
            end
        end
    end
end

